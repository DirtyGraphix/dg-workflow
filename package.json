{
  "name": "dg-workflow",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build && wrangler dev",
    "build": "vite build",
    "db:migrate:local": "wrangler d1 migrations apply dg-workflow --local",
    "db:seed:local": "wrangler d1 execute dg-workflow --local --file=seed/dev-seed.sql",
    "deploy": "vite build && wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "4.13.14",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.9",
    "@cloudflare/workers-types": "5.20261027.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12",
    "wrangler": "4.154.0"
  }
}
