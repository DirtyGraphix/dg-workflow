{
  // Cloudflare Worker that serves the app and its API.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dg-workflow",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/webhooks/*", "/proof/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dg-workflow",
      // Replaced with the real ID when the database is created in Cloudflare.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // Proof images and customer uploads.
  "r2_buckets": [{ "binding": "PROOFS", "bucket_name": "dg-workflow-proofs" }],
  // Hourly job: proof reminders and email delivery.
  "triggers": { "crons": ["0 * * * *"] },
  "vars": {
    "SHOP_TIMEZONE": "America/Chicago",
    "SHOPIFY_SHOP_DOMAIN": "dirtygraphix.myshopify.com",
    // This app's web address, filled in at go-live. Reminder emails sent by the hourly job link from it.
    "APP_ORIGIN": ""
  }
  // Secrets (set with `wrangler secret put`, never committed):
  //   SHOPIFY_WEBHOOK_SECRET  verifies that order webhooks really came from Shopify
  //   SETUP_TOKEN             one-time token for creating the first admin login
  //   KLAVIYO_PRIVATE_KEY     sends customer emails through Klaviyo (emails wait in the outbox until it's set)
}
