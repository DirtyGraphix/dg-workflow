{
  // Cloudflare Worker that serves the app and its API.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dg-workflow",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/webhooks/*", "/proof/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dg-workflow",
      "database_id": "641d9b66-6783-4dec-b829-fac1c80c7361",
      "migrations_dir": "migrations"
    }
  ],
  // Proof images and customer uploads.
  "r2_buckets": [{ "binding": "PROOFS", "bucket_name": "dg-workflow-proofs" }],
  // The design tokens are read into the email layout, so emails use the same colors and fonts.
  "rules": [{ "type": "Text", "globs": ["**/*.css"], "fallthrough": true }],
  // Hourly job: proof reminders and email delivery.
  "triggers": { "crons": ["0 * * * *"] },
  // Keeps request and error logs in the Cloudflare dashboard (Observability), so problems can be traced.
  "observability": { "enabled": true },
  "vars": {
    "SHOP_TIMEZONE": "America/Chicago",
    "SHOPIFY_SHOP_DOMAIN": "dirtygraphix.myshopify.com",
    // This app's web address. Reminder emails sent by the hourly job link from it.
    "APP_ORIGIN": "https://dg-workflow.ty-b26.workers.dev"
  }
  // Secrets (set with `wrangler secret put`, never committed):
  //   SHOPIFY_WEBHOOK_SECRET  verifies that order webhooks really came from Shopify
  //   SETUP_TOKEN             one-time token for creating the first admin login
  //   RESEND_API_KEY          sends customer emails through Resend (emails wait in the outbox until it's set)
}
